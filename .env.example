# Supabase secondary project — sanitized replica, never production keys
NUXT_SUPABASE_URL=
# API key bound to dashboard_reader role (SELECT on dashboard.* only)
NUXT_SUPABASE_DASHBOARD_KEY=
# API key bound to audit_writer role (INSERT on public.audit_log only)
NUXT_SUPABASE_AUDIT_KEY=
# API key bound to dashboard_uploader role (INSERT/UPDATE/DELETE on public.uploaded_dashboards)
NUXT_SUPABASE_UPLOADER_KEY=

# Google OAuth — hd=odysway.com enforced server-side in addition to this hint
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SUPERADMIN_EMAILS=
# Session encryption key — minimum 32 chars, generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
